{
  "name": "@local/study-desk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Study desk: read workspace PDFs in the right Sidebar, ask with quotes/screenshots/phone photos, render LaTeX answers, and generate an annotated class copy with a summary.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": "^0.2.2-rc.5"
  }
}
